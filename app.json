{
  "expo": {
    "name": "parklog",
    "slug": "parklog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.miguel.parklog",
      "appleTeamId": "8D4ZCW7747"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.parklog"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "savePhotosPermission": "O ParkLog guarda na tua galeria as fotos que tiras, se ativares essa opção."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O ParkLog precisa da câmara para fotografar os teus carros."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O ParkLog usa a tua localização para marcar no mapa onde caçaste cada carro."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-build-properties",
      "expo-font"
    ]
  }
}
